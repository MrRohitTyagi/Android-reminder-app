<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_reminder_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Time & Recurrence Column -->
    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07:30"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemRecurrence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Daily"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Divider Line -->
    <View
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:layout_marginHorizontal="10dp"
        android:background="#334155" />

    <!-- Title & Notes Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Reminder title"
            android:textColor="#F1F5F9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Notes or details..."
            android:textColor="#64748B"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvItemStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_active"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="Active"
        android:textColor="#34D399"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
